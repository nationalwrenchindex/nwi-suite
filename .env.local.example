# Copy this file to .env.local and fill in your values

# Supabase — found in: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://krjzvlvnviyyxolxjqdo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# App base URL (used in email links; change to your domain in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Founder SMS alerts — Brock's phone number for instant new-subscriber notifications
BROCK_PHONE_NUMBER=+1xxxxxxxxxx

# Directory auto-population agent (/api/directory-agent/*)
# Google Places API (New) key used to discover mobile mechanics by city
GOOGLE_PLACES_API_KEY=
# Brilliant Directories key scoped to agent-created listings (separate from BD_API_KEY)
BD_DIRECTORY_AGENT_KEY=
# BD membership plan id new listings are created under
BD_SUBSCRIPTION_ID=
# "true" publishes agent-created BD listings live on creation
BD_LISTING_LIVE=false
# Outreach 10DLC number; defaults to +17439016244 when unset
DIRECTORY_AGENT_FROM_NUMBER=+17439016244
