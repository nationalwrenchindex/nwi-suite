# Copy this file to .env.local and fill in your values

# Supabase — found in: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://krjzvlvnviyyxolxjqdo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# App base URL (used in email links; change to your domain in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Founder SMS alerts — Brock's phone number for instant new-subscriber notifications
BROCK_PHONE_NUMBER=+1xxxxxxxxxx

# Stripe recurring price IDs — one per tier in PLANS (src/lib/stripe-plans.ts).
# The env var name is STRIPE_PRICE_<priceKey>. Checkout 503s when the tier being
# purchased has no matching var, and the webhook cannot map the price back to a
# tier, so a paying customer is never activated.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_FULL_SUITE=
STRIPE_PRICE_FULL_SUITE_PLUS=
STRIPE_PRICE_ELITE=
STRIPE_PRICE_FOREMAN=
STRIPE_PRICE_QUICKWRENCH=
STRIPE_PRICE_DETAILER=

# Directory auto-population agent (/api/directory-agent/*)
# Google Places API (New) key used to discover mobile mechanics by city
GOOGLE_PLACES_API_KEY=
# Brilliant Directories key scoped to agent-created listings (separate from BD_API_KEY)
BD_DIRECTORY_AGENT_KEY=
# BD membership plan id new listings are created under
BD_SUBSCRIPTION_ID=
# "true" publishes agent-created BD listings live on creation
BD_LISTING_LIVE=false
# LD outreach 10DLC number used for every LD directory SMS
DIRECTORY_AGENT_FROM_NUMBER=+13367294181

# HD directory auto-population agent (/api/hd-directory-agent/*)
# Brilliant Directories key for the HD directory at nwihd.com
BD_HD_DIRECTORY_AGENT_KEY=
# BD membership plan id new HD listings are created under
BD_HD_SUBSCRIPTION_ID=
# "true" publishes agent-created HD listings live; falls back to BD_LISTING_LIVE
BD_HD_LISTING_LIVE=false
# HD outreach 10DLC number; falls back to DIRECTORY_AGENT_FROM_NUMBER when unset
HD_DIRECTORY_AGENT_FROM_NUMBER=+13362761896
